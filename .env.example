# hrtoken environment variables
# Required variables (must be set as process environment variables):
GITHUB_TOKEN=<your_github_personal_access_token_here>
# Scopes needed: repo (full control of private repositories)
# Do NOT store GITHUB_TOKEN in ~/.bashrc or other shell rc files.
# Set it instead as an environment variable when running hrtool scripts,
# e.g.: GITHUB_TOKEN=abc123 ./checkupdate.sh